# secrets and env
.env
.env.*
.venv/
__pycache__/
*.pyc
node_modules/

# third-party material we must not redistribute (micro1's own assets)
d.pdf
context/01-PROBLEM-PDF.md
context/media/
context/images/
context/slices/
context/screenshots/
context/raw/

# operator personal data (ground rule 08)
context/02-ABOUT-ME.md
context/me/

# research scratch from prior sessions - large, superseded, not part of the build.
# ANCHORED to the repo root with a leading slash, and the reason is a real near-miss:
# the unanchored `probe/` also matched `docs/trajectories/probe/`, so a directory of
# REQUIRED agent trajectories (hard rule 10) was silently untrackable. An ignore rule
# that quietly swallows evidence is the same failure mode as a strip counter that
# prints zero because it is looking for the wrong tag. Anchor them.
/aec/
/bip/
/killtest/
/probe/
/replay/
/scraper/
/hz.html
/wl.html

# bulk corpus downloads - NEVER tracked. data/ holds only extracted, frozen artifacts.
*.xml
!data/**/*.xml
data/raw/
data/cache/
dist/
*.zip

# large media - the video is hosted, not committed (see CH-13)
*.mp4
*.mov
*.mkv

# Windows/Cygwin crash dumps - these land in the repo root unannounced
*.stackdump

# Per-item agent trajectories. Hard rule 10 requires every run logged, and every
# record survives - in the BUNDLED docs/trajectories/arms/<arm>-rep<N>.jsonl, one
# file per arm-rep, which is the same convention docs/trajectories/build/ already
# uses. 496 individual files would blow the pre-commit tracked-file guard, and the
# guard is right: the 50 MB submission cap is the one limit that must not move.
docs/trajectories/*/per-item/

# Q25: a blank regenerable form, untracked to make room for the CH-06 session
# transcript under the 300-file guard. Regenerate with human_time_study.py.
docs/evidence/ch09-removed/human-time-worksheet.csv
docs/evidence/ch09-removed/human-time-blind.md
